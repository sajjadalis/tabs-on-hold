{
  "name": "tabs-on-hold",
  "description": "Save and organize tabs with screenshot previews and easy restore.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajjadalis/tabs-on-hold.git"
  },
  "homepage": "https://github.com/sajjadalis/tabs-on-hold#readme",
  "bugs": {
    "url": "https://github.com/sajjadalis/tabs-on-hold/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 4175",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4176",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write lib ui entrypoints tests scripts docs wxt.config.ts vitest.config.ts tsconfig.json package.json README.md",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.1.32",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.0",
    "wxt": "^0.20.11"
  }
}
